{
  "hosting": {
    "public": "frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/management/**",
        "destination": "/management/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "functions": {
      "engines": {
        "node": "16"
      }
    }
  },
  "functions": {
    "source": "backend"
  },
  "emulators": {
    "hosting": {
      "port": 9005
    },
    "ui": {
      "enabled": true,
      "port": 6001
    },
    "singleProjectMode": true,
    "apphosting": {
      "port": 5002,
      "rootDirectory": "./",
      "startCommand": "npm run dev"
    },
    "functions": {
      "port": 5006,
      "host": "0.0.0.0"
    }
  }
}
